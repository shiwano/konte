{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/core/dsl/template-entry.ts",
    "src/pages/preview/index.tsx",
    "src/pages/settings/index.tsx",
    "scripts/*.ts",
    "src/pages/*/styles/index.css"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "scripts/**/*.ts"
  ],
  "ignore": [
    "src/cli/templates/**",
    "src/core/__tests__/fixtures/**"
  ],
  "ignoreBinaries": [
    "gh-actions-lock",
    "waza",
    "ffmpeg"
  ],
  "ignoreDependencies": [
    "@hyperframes/core",
    "@hyperframes/parsers"
  ]
}

{
  "env": {
    "CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"export PATH=\\\"$CLAUDE_PROJECT_DIR/.konte/bin:\\$PATH\\\"\" >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(konte:*)"
    ],
    "deny": [
      "Read(./konte.credentials.json)",
      "Edit(./konte.credentials.json)",
      "Edit(./.claude/settings.json)",
      "Edit(./.codex/config.toml)",
      "Bash(* konte.credentials.json)",
      "Bash(* konte.credentials.json *)"
    ]
  },
  "enabledMcpjsonServers": [
    "konte"
  ],
  "extraKnownMarketplaces": {
    "konte": {
      "source": {
        "source": "github",
        "repo": "shiwano/konte",
        "ref": "plugin"
      }
    }
  },
  "enabledPlugins": {
    "konte@konte": true,
    "typescript-lsp@claude-plugins-official": false
  }
}

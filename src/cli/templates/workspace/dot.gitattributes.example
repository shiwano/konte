# Rename to .gitattributes to keep video assets in Git LFS.
videos/*/assets/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.webm filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.mov filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.mkv filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.avi filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.gif filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.bmp filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.tiff filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.flac filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.aac filter=lfs diff=lfs merge=lfs -text
videos/*/assets/**/*.m4a filter=lfs diff=lfs merge=lfs -text
